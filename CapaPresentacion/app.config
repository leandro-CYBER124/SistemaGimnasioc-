<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Autenticación de Windows sobre SQL Server LocalDB (la misma instancia que ves en SSMS).
         Si usás otra instancia, cambiá Data Source (ej.: .\SQLEXPRESS, localhost) -->
    <add name="bd_gimnasio"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=bd_gimnasio;Integrated Security=True;Connect Timeout=10"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
